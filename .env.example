# ========================================================
# GameCafe Environment Configuration Template
# 복사하여 .env 파일을 생성하고 실제 환경에 맞게 값을 수정하세요.
# ========================================================

# 서버 포트 및 환경
PORT=3000
NODE_ENV=development

# 세션 암호화 비밀키 (임의의 무작위 문자열)
SESSION_SECRET=gamecafe_super_secret_session_key_change_in_production

# MySQL 8.4 데이터베이스 연결 정보
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=gamecafe
DB_CONNECTION_LIMIT=10
