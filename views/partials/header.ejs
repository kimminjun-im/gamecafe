<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'GameCafe - 게이머를 위한 종합 커뮤니티' %></title>
  
  <!-- 스타일시트 로드 -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>

  <!-- 상단 글로벌 네비게이션 바 (GNB) -->
  <header class="site-header">
    <div class="container header-inner">
      <!-- 브랜드 로고 -->
      <a href="/" class="brand-logo">
        <div class="brand-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="12" rx="4"></rect>
            <path d="M6 12h4m-2-2v4"></path>
            <circle cx="15" cy="11" r="1" fill="currentColor"></circle>
            <circle cx="18" cy="13" r="1" fill="currentColor"></circle>
          </svg>
        </div>
        <div class="brand-text">Game<span>Cafe</span></div>
      </a>

      <!-- 데스크톱 네비게이션 메뉴 -->
      <nav class="gnb-nav">
        <a href="/" class="nav-link <%= typeof currentPath !== 'undefined' && currentPath === '/' ? 'active' : '' %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          홈
        </a>

        <!-- 게임별 라운지 드롭다운 메뉴 -->
        <div class="nav-dropdown">
          <button class="dropdown-trigger" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
            게임별 라운지
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="dropdown-menu">
            <% if (typeof navGames !== 'undefined' && navGames.length > 0) { %>
              <% navGames.forEach(game => { %>
                <a href="/games/<%= game.slug %>" class="dropdown-item">
                  <span class="dropdown-item-icon">🎮</span>
                  <%= game.name %>
                </a>
              <% }); %>
            <% } else { %>
              <a href="/games/lol" class="dropdown-item"><span class="dropdown-item-icon">⚔️</span>리그 오브 레전드</a>
              <a href="/games/valorant" class="dropdown-item"><span class="dropdown-item-icon">🎯</span>발로란트</a>
              <a href="/games/overwatch2" class="dropdown-item"><span class="dropdown-item-icon">🛡️</span>오버워치 2</a>
              <a href="/games/minecraft" class="dropdown-item"><span class="dropdown-item-icon">⛏️</span>마인크래프트</a>
            <% } %>
          </div>
        </div>

        <a href="/games/lol?category=guide" class="nav-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          추천 공략
        </a>
        <a href="/games/lol?category=recruit" class="nav-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          파티/듀오 구인
        </a>
      </nav>

      <!-- 상단 통합 검색창 UI -->
      <form action="/search" method="GET" class="header-search-box" style="display: flex; align-items: center; position: relative;">
        <input 
          type="text" 
          name="query" 
          placeholder="통합 검색..." 
          style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-full); padding: 7px 14px 7px 32px; font-size: 0.84rem; color: #fff; width: 150px; outline: none; transition: width 0.2s ease, border-color 0.2s ease;"
          onfocus="this.style.width='210px'; this.style.borderColor='var(--primary)';"
          onblur="this.style.width='150px'; this.style.borderColor='var(--border-subtle)';"
        >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 11px; color: var(--text-dim); pointer-events: none;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </form>

      <!-- 우측 회원 액션 (로그인 상태에 따라 동적 변경) -->
      <div class="header-actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="user-profile-menu" style="display: flex; align-items: center; gap: 10px;">
            <a href="/profile" style="display: flex; align-items: center; gap: 8px; background: var(--bg-card); padding: 5px 12px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle); transition: border-color 0.2s;" onmouseover="this.style.borderColor='var(--primary)'" onmouseout="this.style.borderColor='var(--border-subtle)'">
              <span style="width: 26px; height: 26px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; color: #fff; overflow: hidden;">
                <% if (user.profile_image && user.profile_image !== '/images/default-avatar.png') { %>
                  <img src="<%= user.profile_image %>" alt="<%= user.nickname %>" style="width:100%; height:100%; object-fit:cover;">
                <% } else { %>
                  <%= (user.nickname || 'U').charAt(0) %>
                <% } %>
              </span>
              <span class="user-greeting" style="font-size: 0.88rem; font-weight: 600; color: #fff;">
                <%= user.nickname || '사용자' %>
              </span>
              <% if (user.role === 'admin') { %>
                <span class="badge badge-global-notice" style="font-size: 0.68rem; padding: 1px 6px;">ADMIN</span>
              <% } %>
            </a>
            <% if (user.role === 'admin') { %>
              <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="color: #fbbf24; border-color: rgba(251, 191, 36, 0.4);">관리자 콘솔</a>
            <% } %>
            <a href="/auth/logout" class="btn btn-secondary btn-sm" style="color: #f43f5e;">로그아웃</a>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-secondary btn-sm">로그인</a>
          <a href="/auth/register" class="btn btn-primary btn-sm">회원가입</a>
        <% } %>

        <!-- 모바일 햄버거 토글 버튼 -->
        <button type="button" class="btn-mobile-menu" aria-label="메뉴 열기">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- 모바일 오프캔버스 메뉴 드로어 -->
  <div class="mobile-drawer">
    <div class="drawer-header">
      <div class="brand-text" style="font-weight: 800; color: #fff;">Game<span style="color: var(--accent-cyan-light);">Cafe</span></div>
      <button type="button" class="drawer-close" aria-label="메뉴 닫기">&times;</button>
    </div>

    <!-- 모바일 유저 상태 -->
    <div style="padding-bottom: 12px; border-bottom: 1px solid var(--border-subtle);">
      <% if (typeof user !== 'undefined' && user) { %>
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 8px;">
            <span style="width: 30px; height: 30px; border-radius: 50%; background: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700;">
              <%= (user.nickname || 'U').charAt(0) %>
            </span>
            <div>
              <div style="font-weight: 700; color: #fff;"><%= user.nickname || '사용자' %></div>
              <div style="font-size: 0.75rem; color: var(--text-dim);"><%= user.email || '' %></div>
            </div>
          </div>
          <div style="display: flex; gap: 6px;">
            <% if (user.role === 'admin') { %>
              <a href="/admin/dashboard" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 4px 8px; color: #fbbf24;">관리자</a>
            <% } %>
            <a href="/profile" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 4px 8px;">마이페이지</a>
            <a href="/auth/logout" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 4px 8px; color: #f43f5e;">로그아웃</a>
          </div>
        </div>
      <% } else { %>
        <div style="display: flex; gap: 8px;">
          <a href="/auth/login" class="btn btn-secondary btn-sm" style="flex: 1;">로그인</a>
          <a href="/auth/register" class="btn btn-primary btn-sm" style="flex: 1;">회원가입</a>
        </div>
      <% } %>
    </div>

    <div class="drawer-links">
      <a href="/" class="nav-link">🏠 홈</a>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-dim); margin-top: 10px; text-transform: uppercase;">게임 라운지</div>
      <a href="/games/lol" class="nav-link">⚔️ 리그 오브 레전드</a>
      <a href="/games/valorant" class="nav-link">🎯 발로란트</a>
      <a href="/games/overwatch2" class="nav-link">🛡️ 오버워치 2</a>
      <a href="/games/minecraft" class="nav-link">⛏️ 마인크래프트</a>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-dim); margin-top: 10px; text-transform: uppercase;">커뮤니티</div>
      <a href="/games/lol?category=guide" class="nav-link">📚 추천 공략</a>
      <a href="/games/lol?category=recruit" class="nav-link">👥 파티/듀오 구인</a>
    </div>
  </div>
  <div class="drawer-overlay"></div>
