<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/board.css">

<main class="board-wrapper">
  <div class="container">

    <article class="detail-card">
      <!-- 1. 상단 경로 네비게이션 -->
      <div class="detail-nav-path">
        <a href="/">홈</a>
        <span>&gt;</span>
        <% if (post.game_slug) { %>
          <a href="/games/<%= post.game_slug %>"><%= post.game_name %></a>
          <span>&gt;</span>
        <% } %>
        <span><%= post.category_name %></span>
      </div>

      <!-- 2. 게시글 헤더 -->
      <header class="detail-header">
        <div style="margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
          <% if (post.notice_type === 'global') { %>
            <span class="badge badge-global-notice">전체공지</span>
          <% } else if (post.notice_type === 'game') { %>
            <span class="badge badge-game-notice">게임공지</span>
          <% } %>
          <span class="badge badge-category"><%= post.category_name %></span>
          <% if (post.game_name) { %>
            <span class="badge badge-game"><%= post.game_name %></span>
          <% } %>
        </div>

        <h1 class="detail-title"><%= post.title %></h1>

        <div class="detail-meta">
          <div class="detail-author-box">
            <div class="author-avatar">
              <%= (post.author_nickname || 'U').charAt(0) %>
            </div>
            <div class="author-info-text">
              <span style="font-weight: 700; color: #ffffff;">
                <%= post.author_nickname %>
                <% if (post.author_role === 'admin') { %>
                  <span class="badge badge-global-notice" style="font-size: 0.65rem;">ADMIN</span>
                <% } %>
              </span>
              <span style="font-size: 0.8rem; color: var(--text-dim);">
                <%= post.created_at %>
              </span>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 16px;">
            <span title="조회 수" style="display: flex; align-items: center; gap: 4px;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <%= post.view_count %>
            </span>
            <span title="댓글 수" style="display: flex; align-items: center; gap: 4px; color: var(--accent-cyan-light);">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
              <span id="postCommentCountBadge"><%= post.comment_count %></span>
            </span>
          </div>
        </div>
      </header>

      <!-- 3. 게시글 본문 -->
      <div class="detail-body"><%= post.content %></div>

      <!-- 4. 실시간 비동기 좋아요(추천) 버튼 영역 -->
      <div class="detail-like-wrapper">
        <button 
          type="button" 
          id="btnLike" 
          class="btn-like <%= (typeof isLiked !== 'undefined' && isLiked) ? 'liked' : '' %>"
          data-post-id="<%= post.id %>"
        >
          <svg class="like-icon" width="20" height="20" viewBox="0 0 24 24" fill="<%= (typeof isLiked !== 'undefined' && isLiked) ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span class="like-text">좋아요</span>
          <span id="likeCount" class="like-count"><%= post.like_count %></span>
        </button>
      </div>

      <!-- 5. 하단 버튼 바 (목록 이동, 수정, 삭제) -->
      <footer class="detail-actions-bar">
        <div>
          <a href="/games/<%= post.game_slug || 'lol' %>" class="btn btn-secondary">
            &larr; 목록으로
          </a>
        </div>

        <% if (canEditOrDelete) { %>
          <div style="display: flex; align-items: center; gap: 10px;">
            <a href="/posts/<%= post.id %>/edit" class="btn btn-secondary">
              수정
            </a>
            <form action="/posts/<%= post.id %>/delete" method="POST" onsubmit="return confirm('정말 이 게시글을 삭제하시겠습니까?');" style="display: inline;">
              <button type="submit" class="btn btn-secondary" style="color: #f43f5e; border-color: rgba(244, 63, 94, 0.4);">
                삭제
              </button>
            </form>
          </div>
        <% } %>
      </footer>
    </article>

    <!-- 6. 댓글 및 대댓글 섹션 -->
    <section class="comments-section">
      <div class="comments-header">
        <h3 class="comments-title">
          <span>💬</span>
          댓글 <span class="comments-count" id="commentTotalCount"><%= post.comment_count %></span>
        </h3>
      </div>

      <!-- 최상위 댓글 작성 폼 -->
      <% if (typeof user !== 'undefined' && user) { %>
        <form action="/api/comments" method="POST" class="comment-write-form">
          <input type="hidden" name="post_id" value="<%= post.id %>">
          <textarea 
            name="content" 
            class="comment-textarea" 
            placeholder="건전하고 따뜻한 댓글을 남겨주세요." 
            required
          ></textarea>
          <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
            <button type="submit" class="btn btn-primary btn-sm">댓글 등록</button>
          </div>
        </form>
      <% } else { %>
        <div class="comment-login-notice">
          <span>댓글을 작성하려면 로그인이 필요합니다.</span>
          <a href="/auth/login" class="btn btn-secondary btn-sm">로그인하기</a>
        </div>
      <% } %>

      <!-- 댓글 목록 (계층형) -->
      <div class="comments-list">
        <% if (typeof comments !== 'undefined' && comments.length > 0) { %>
          <% comments.forEach(comment => { %>
            <div class="comment-item <%= comment.is_deleted ? 'is-deleted' : '' %>" id="comment-<%= comment.id %>">
              
              <% if (comment.is_deleted) { %>
                <!-- 삭제된 부모 댓글 안내 (대댓글 보존용) -->
                <div class="comment-deleted-text">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                  작성자에 의해 삭제된 댓글입니다.
                </div>
              <% } else { %>
                <!-- 정상 부모 댓글 -->
                <div class="comment-header">
                  <div class="comment-author-box">
                    <span class="comment-avatar"><%= (comment.author_nickname || 'U').charAt(0) %></span>
                    <span class="comment-nickname"><%= comment.author_nickname %></span>
                    <% if (comment.author_role === 'admin') { %>
                      <span class="badge badge-global-notice" style="font-size: 0.65rem;">ADMIN</span>
                    <% } %>
                    <span class="comment-date"><%= comment.created_at ? comment.created_at.substring(0, 16) : '' %></span>
                  </div>

                  <div class="comment-actions">
                    <% if (typeof user !== 'undefined' && user) { %>
                      <button type="button" class="btn-reply-toggle" data-comment-id="<%= comment.id %>">답글</button>
                      <% if (user.id === comment.user_id) { %>
                        <button type="button" class="btn-edit-toggle" data-comment-id="<%= comment.id %>">수정</button>
                      <% } %>
                      <% if (user.id === comment.user_id || user.role === 'admin') { %>
                        <form action="/api/comments/<%= comment.id %>/delete" method="POST" onsubmit="return confirm('댓글을 삭제하시겠습니까?');" style="display:inline;">
                          <button type="submit" class="btn-action-delete">삭제</button>
                        </form>
                      <% } %>
                    <% } %>
                  </div>
                </div>

                <div class="comment-content" id="comment-text-<%= comment.id %>"><%= comment.content %></div>

                <!-- 인라인 댓글 수정 폼 -->
                <div class="comment-edit-form" id="edit-form-<%= comment.id %>" style="display: none;">
                  <textarea class="comment-textarea edit-textarea-<%= comment.id %>"><%= comment.content %></textarea>
                  <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                    <button type="button" class="btn btn-secondary btn-sm btn-cancel-edit" data-comment-id="<%= comment.id %>">취소</button>
                    <button type="button" class="btn btn-primary btn-sm btn-submit-edit" data-comment-id="<%= comment.id %>">수정완료</button>
                  </div>
                </div>
              <% } %>

              <!-- 인라인 대댓글 작성 폼 (토글) -->
              <% if (typeof user !== 'undefined' && user) { %>
                <div class="reply-write-box" id="reply-box-<%= comment.id %>" style="display: none;">
                  <form action="/api/comments" method="POST">
                    <input type="hidden" name="post_id" value="<%= post.id %>">
                    <input type="hidden" name="parent_id" value="<%= comment.id %>">
                    <textarea name="content" class="comment-textarea" placeholder="답글을 작성하세요..." required></textarea>
                    <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                      <button type="button" class="btn btn-secondary btn-sm btn-cancel-reply" data-comment-id="<%= comment.id %>">취소</button>
                      <button type="submit" class="btn btn-cyan btn-sm">답글 등록</button>
                    </div>
                  </form>
                </div>
              <% } %>

              <!-- 자식 대댓글 목록 (Replies) -->
              <% if (comment.replies && comment.replies.length > 0) { %>
                <div class="replies-container">
                  <% comment.replies.forEach(reply => { %>
                    <div class="reply-item <%= reply.is_deleted ? 'is-deleted' : '' %>" id="comment-<%= reply.id %>">
                      <div class="reply-prefix">↳</div>
                      <div style="flex-grow: 1;">
                        <% if (reply.is_deleted) { %>
                          <div class="comment-deleted-text">작성자에 의해 삭제된 댓글입니다.</div>
                        <% } else { %>
                          <div class="comment-header">
                            <div class="comment-author-box">
                              <span class="comment-avatar reply-avatar"><%= (reply.author_nickname || 'U').charAt(0) %></span>
                              <span class="comment-nickname"><%= reply.author_nickname %></span>
                              <% if (reply.author_role === 'admin') { %>
                                <span class="badge badge-global-notice" style="font-size: 0.65rem;">ADMIN</span>
                              <% } %>
                              <span class="comment-date"><%= reply.created_at ? reply.created_at.substring(0, 16) : '' %></span>
                            </div>

                            <div class="comment-actions">
                              <% if (typeof user !== 'undefined' && user) { %>
                                <% if (user.id === reply.user_id) { %>
                                  <button type="button" class="btn-edit-toggle" data-comment-id="<%= reply.id %>">수정</button>
                                <% } %>
                                <% if (user.id === reply.user_id || user.role === 'admin') { %>
                                  <form action="/api/comments/<%= reply.id %>/delete" method="POST" onsubmit="return confirm('답글을 삭제하시겠습니까?');" style="display:inline;">
                                    <button type="submit" class="btn-action-delete">삭제</button>
                                  </form>
                                <% } %>
                              <% } %>
                            </div>
                          </div>

                          <div class="comment-content" id="comment-text-<%= reply.id %>"><%= reply.content %></div>

                          <!-- 인라인 대댓글 수정 폼 -->
                          <div class="comment-edit-form" id="edit-form-<%= reply.id %>" style="display: none;">
                            <textarea class="comment-textarea edit-textarea-<%= reply.id %>"><%= reply.content %></textarea>
                            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px;">
                              <button type="button" class="btn btn-secondary btn-sm btn-cancel-edit" data-comment-id="<%= reply.id %>">취소</button>
                              <button type="button" class="btn btn-primary btn-sm btn-submit-edit" data-comment-id="<%= reply.id %>">수정완료</button>
                            </div>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>

            </div>
          <% }); %>
        <% } else { %>
          <div class="no-comments-box">
            아직 작성된 댓글이 없습니다. 첫 번째 댓글을 남겨보세요!
          </div>
        <% } %>
      </div>

    </section>

  </div>
</main>

<!-- 게시글 상세 전용 비동기 스크립트 -->
<script src="/js/postDetail.js"></script>

<%- include('../partials/footer') %>
