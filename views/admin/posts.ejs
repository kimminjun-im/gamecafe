<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/board.css">

<div class="admin-layout">
  <%- include('sidebar') %>

  <main class="admin-main">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          <span>📝</span>
          게시글 관리
        </h1>
        <p style="color: var(--text-dim); font-size: 0.95rem; margin-top: 4px;">
          커뮤니티의 모든 게시글을 모니터링하고, 부적절한 글을 관리자 권한으로 삭제합니다.
        </p>
      </div>
    </div>

    <!-- 알림 메시지 -->
    <% if (successMessage) { %>
      <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 12px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600;">
        <%= successMessage %>
      </div>
    <% } %>
    <% if (errorMessage) { %>
      <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); color: #fb7185; padding: 12px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600;">
        <%= errorMessage %>
      </div>
    <% } %>

    <!-- 검색 및 필터 폼 -->
    <div class="admin-card" style="padding: 16px 20px; margin-bottom: 20px;">
      <form action="/admin/posts" method="GET" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <select name="game" class="search-select">
          <option value="all" <%= selectedGame === 'all' ? 'selected' : '' %>>모든 게임 라운지</option>
          <% if (typeof games !== 'undefined' && games.length > 0) { %>
            <% games.forEach(g => { %>
              <option value="<%= g.slug %>" <%= selectedGame === g.slug ? 'selected' : '' %>><%= g.name %></option>
            <% }); %>
          <% } %>
        </select>
        <input 
          type="text" 
          name="search" 
          class="form-input" 
          style="padding: 8px 14px; max-width: 300px;" 
          placeholder="제목 또는 작성자 검색..." 
          value="<%= searchQuery %>"
        >
        <button type="submit" class="btn btn-secondary btn-sm">검색</button>
        <span style="margin-left: auto; color: var(--text-dim); font-size: 0.88rem;">
          총 게시글: <strong style="color: #fff;"><%= totalCount %></strong>개
        </span>
      </form>
    </div>

    <!-- 게시글 목록 테이블 -->
    <div class="admin-card" style="padding: 0; overflow: hidden;">
      <table class="board-table">
        <thead>
          <tr>
            <th style="width: 70px; text-align: center;">번호</th>
            <th style="width: 140px;">게임 라운지</th>
            <th style="width: 100px;">카테고리</th>
            <th>제목</th>
            <th style="width: 130px;">작성자</th>
            <th style="width: 110px;">작성일</th>
            <th style="width: 70px; text-align: center;">조회</th>
            <th style="width: 70px; text-align: center;">추천</th>
            <th style="width: 90px; text-align: center;">관리</th>
          </tr>
        </thead>
        <tbody>
          <% if (posts && posts.length > 0) { %>
            <% posts.forEach(p => { %>
              <tr>
                <td style="text-align: center; color: var(--text-dim);"><%= p.id %></td>
                <td><span class="badge badge-game"><%= p.game_name || '전체공지' %></span></td>
                <td><span class="badge badge-category"><%= p.category_name %></span></td>
                <td>
                  <a href="/posts/<%= p.id %>" class="post-title-link" target="_blank">
                    <%= p.title %>
                    <% if (p.comment_count > 0) { %>
                      <span class="comment-count-badge">[<%= p.comment_count %>]</span>
                    <% } %>
                  </a>
                </td>
                <td style="color: var(--text-secondary);"><%= p.author_nickname %></td>
                <td style="color: var(--text-dim); font-size: 0.85rem;"><%= p.created_at ? p.created_at.substring(0, 10) : '' %></td>
                <td style="text-align: center; color: var(--text-dim);"><%= p.view_count %></td>
                <td style="text-align: center; color: var(--accent-rose); font-weight: 700;"><%= p.like_count %></td>
                <td style="text-align: center;">
                  <form action="/admin/posts/<%= p.id %>/delete" method="POST" onsubmit="return confirm('이 게시글을 정말 강제 삭제하시겠습니까?');">
                    <button type="submit" class="btn btn-secondary btn-sm" style="color: #f43f5e; padding: 4px 8px; font-size: 0.78rem;">
                      강제삭제
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="9" style="text-align: center; padding: 48px; color: var(--text-dim);">검색된 게시글이 없습니다.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- 페이징 -->
    <% if (totalPages > 1) { %>
      <div class="pagination" style="justify-content: center; margin-top: 24px;">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="/admin/posts?page=<%= p %><%= searchQuery ? `&search=${searchQuery}` : '' %><%= selectedGame !== 'all' ? `&game=${selectedGame}` : '' %>" class="page-btn <%= currentPage === p ? 'active' : '' %>">
            <%= p %>
          </a>
        <% } %>
      </div>
    <% } %>

  </main>
</div>

<%- include('../partials/footer') %>
