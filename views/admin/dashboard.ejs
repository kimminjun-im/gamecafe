<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/board.css">

<div class="admin-layout">
  <%- include('sidebar') %>

  <main class="admin-main">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          <span>📊</span>
          관리자 대시보드
        </h1>
        <p style="color: var(--text-dim); font-size: 0.95rem; margin-top: 4px;">
          GameCafe 커뮤니티의 실시간 회원, 게시글, 댓글 현황 및 최신 활동을 모니터링합니다.
        </p>
      </div>
      <div>
        <span class="status-badge-active" style="padding: 6px 12px; font-size: 0.85rem;">
          ● 시스템 정상 가동 중
        </span>
      </div>
    </div>

    <!-- 1. 통계 카드 4개 그리드 -->
    <div class="stat-cards-grid">
      <!-- 전체 회원 수 -->
      <div class="stat-card">
        <div class="stat-card-icon" style="color: var(--primary-light);">👥</div>
        <div>
          <div class="stat-card-label">전체 회원 수</div>
          <div class="stat-card-value"><%= stats.totalUsers %></div>
        </div>
      </div>

      <!-- 전체 게시글 수 -->
      <div class="stat-card">
        <div class="stat-card-icon" style="color: var(--accent-cyan-light);">📝</div>
        <div>
          <div class="stat-card-label">전체 게시글 수</div>
          <div class="stat-card-value"><%= stats.totalPosts %></div>
        </div>
      </div>

      <!-- 전체 댓글 수 -->
      <div class="stat-card">
        <div class="stat-card-icon" style="color: #a855f7;">💬</div>
        <div>
          <div class="stat-card-label">전체 댓글 수</div>
          <div class="stat-card-value"><%= stats.totalComments %></div>
        </div>
      </div>

      <!-- 오늘 등록된 글 -->
      <div class="stat-card">
        <div class="stat-card-icon" style="color: var(--accent-rose);">⚡</div>
        <div>
          <div class="stat-card-label">오늘 등록된 글</div>
          <div class="stat-card-value" style="color: var(--accent-rose);"><%= stats.todayPosts %></div>
        </div>
      </div>
    </div>

    <!-- 2. 최근 가입 회원 & 최근 게시글 그리드 -->
    <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 24px;">
      
      <!-- 최근 가입 회원 -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h2 class="admin-card-title">
            <span>👤</span>
            최근 가입 회원
          </h2>
          <a href="/admin/users" style="font-size: 0.85rem; color: var(--accent-cyan-light);">전체보기 &rarr;</a>
        </div>
        <table class="board-table">
          <thead>
            <tr>
              <th>닉네임</th>
              <th>이메일</th>
              <th>상태</th>
              <th>가입일</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentUsers && recentUsers.length > 0) { %>
              <% recentUsers.forEach(u => { %>
                <tr>
                  <td style="font-weight: 700; color: #fff;">
                    <a href="/users/<%= u.id %>"><%= u.nickname %></a>
                    <% if (u.role === 'admin') { %>
                      <span class="badge badge-global-notice" style="font-size: 0.65rem;">ADMIN</span>
                    <% } %>
                  </td>
                  <td style="color: var(--text-dim); font-size: 0.85rem;"><%= u.email %></td>
                  <td>
                    <% if (u.is_banned) { %>
                      <span class="status-badge-banned">정지</span>
                    <% } else { %>
                      <span class="status-badge-active">정상</span>
                    <% } %>
                  </td>
                  <td style="color: var(--text-dim); font-size: 0.82rem;"><%= u.created_at ? u.created_at.substring(0, 10) : '' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="4" style="text-align: center; color: var(--text-dim);">회원이 없습니다.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- 최근 등록 게시글 -->
      <div class="admin-card">
        <div class="admin-card-header">
          <h2 class="admin-card-title">
            <span>📝</span>
            최근 등록 게시글
          </h2>
          <a href="/admin/posts" style="font-size: 0.85rem; color: var(--accent-cyan-light);">전체보기 &rarr;</a>
        </div>
        <table class="board-table">
          <thead>
            <tr>
              <th>게임/분류</th>
              <th>제목</th>
              <th>작성자</th>
              <th>작성일</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentPosts && recentPosts.length > 0) { %>
              <% recentPosts.forEach(p => { %>
                <tr>
                  <td>
                    <span class="badge badge-game"><%= p.game_name || '전체' %></span>
                  </td>
                  <td>
                    <a href="/posts/<%= p.id %>" class="post-title-link">
                      <%= p.title %>
                    </a>
                  </td>
                  <td style="color: var(--text-secondary); font-size: 0.88rem;"><%= p.author_nickname %></td>
                  <td style="color: var(--text-dim); font-size: 0.82rem;"><%= p.created_at ? p.created_at.substring(0, 10) : '' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="4" style="text-align: center; color: var(--text-dim);">게시글이 없습니다.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </div>

  </main>
</div>

<%- include('../partials/footer') %>
