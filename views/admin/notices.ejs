<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/board.css">

<div class="admin-layout">
  <%- include('sidebar') %>

  <main class="admin-main">
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          <span>📢</span>
          공지사항 관리
        </h1>
        <p style="color: var(--text-dim); font-size: 0.95rem; margin-top: 4px;">
          전역 사이트 전체 공지 또는 특정 게임 라운지 상단 고정 공지사항을 작성하고 관리합니다.
        </p>
      </div>
    </div>

    <!-- 알림 메시지 -->
    <% if (successMessage) { %>
      <div style="background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 12px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600;">
        <%= successMessage %>
      </div>
    <% } %>
    <% if (errorMessage) { %>
      <div style="background: rgba(244, 63, 94, 0.12); border: 1px solid rgba(244, 63, 94, 0.35); color: #fb7185; padding: 12px 18px; border-radius: var(--radius-md); margin-bottom: 20px; font-weight: 600;">
        <%= errorMessage %>
      </div>
    <% } %>

    <!-- 1. 신규 공지사항 작성 폼 -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2 class="admin-card-title">
          <span>✏️</span>
          신규 공지사항 작성
        </h2>
      </div>

      <form action="/admin/notices/create" method="POST">
        <!-- 공지 구분 선택 -->
        <div style="display: flex; align-items: center; gap: 24px; margin-bottom: 18px; padding: 12px 16px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <span style="font-weight: 700; color: #fff; font-size: 0.92rem;">공지 구분:</span>
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-main);">
            <input type="radio" name="notice_type" value="global" checked id="radioGlobal">
            <span class="badge badge-global-notice">사이트 전체 공지 (전역 상단 고정)</span>
          </label>
          <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: var(--text-main);">
            <input type="radio" name="notice_type" value="game" id="radioGame">
            <span class="badge badge-game-notice">특정 게임 라운지 공지</span>
          </label>

          <!-- 게임 선택 셀렉트 (game 선택 시 표시) -->
          <div id="gameSelectBox" style="display: none; margin-left: 10px;">
            <select name="game_id" class="search-select">
              <% if (games && games.length > 0) { %>
                <% games.forEach(g => { %>
                  <option value="<%= g.id %>"><%= g.name %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <!-- 공지 제목 -->
        <div class="form-group" style="margin-bottom: 16px;">
          <label for="title" class="form-label">공지사항 제목</label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            class="form-input" 
            style="padding-left: 14px;" 
            placeholder="공지사항 제목을 입력하세요" 
            required
          >
        </div>

        <!-- 공지 내용 -->
        <div class="form-group" style="margin-bottom: 20px;">
          <label for="content" class="form-label">공지 내용</label>
          <textarea 
            id="content" 
            name="content" 
            class="form-textarea" 
            style="min-height: 140px;" 
            placeholder="공지할 내용을 작성하세요..." 
            required
          ></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary">공지사항 등록</button>
        </div>
      </form>
    </div>

    <!-- 2. 등록된 공지사항 목록 테이블 -->
    <div class="admin-card" style="padding: 0; overflow: hidden;">
      <div class="admin-card-header" style="padding: 20px 24px; margin-bottom: 0;">
        <h2 class="admin-card-title">
          <span>📋</span>
          등록된 공지사항 목록 (<%= totalCount %>개)
        </h2>
      </div>

      <table class="board-table">
        <thead>
          <tr>
            <th style="width: 70px; text-align: center;">번호</th>
            <th style="width: 120px;">공지 구분</th>
            <th style="width: 140px;">대상 게임</th>
            <th>제목</th>
            <th style="width: 120px;">작성자</th>
            <th style="width: 110px;">작성일</th>
            <th style="width: 70px; text-align: center;">조회</th>
            <th style="width: 90px; text-align: center;">관리</th>
          </tr>
        </thead>
        <tbody>
          <% if (notices && notices.length > 0) { %>
            <% notices.forEach(n => { %>
              <tr>
                <td style="text-align: center; color: var(--text-dim);"><%= n.id %></td>
                <td>
                  <% if (n.notice_type === 'global') { %>
                    <span class="badge badge-global-notice">전체공지</span>
                  <% } else { %>
                    <span class="badge badge-game-notice">게임공지</span>
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-game"><%= n.game_name || '전체(사이트)' %></span>
                </td>
                <td>
                  <a href="/posts/<%= n.id %>" class="post-title-link" target="_blank">
                    <%= n.title %>
                  </a>
                </td>
                <td style="color: var(--text-secondary);"><%= n.author_nickname %></td>
                <td style="color: var(--text-dim); font-size: 0.85rem;"><%= n.created_at ? n.created_at.substring(0, 10) : '' %></td>
                <td style="text-align: center; color: var(--text-dim);"><%= n.view_count %></td>
                <td style="text-align: center;">
                  <form action="/admin/posts/<%= n.id %>/delete" method="POST" onsubmit="return confirm('이 공지사항을 삭제하시겠습니까?');">
                    <button type="submit" class="btn btn-secondary btn-sm" style="color: #f43f5e; padding: 4px 8px; font-size: 0.78rem;">
                      삭제
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="8" style="text-align: center; padding: 48px; color: var(--text-dim);">등록된 공지사항이 없습니다.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </main>
</div>

<script>
  // 라디오 버튼 전환 시 게임 선택 셀렉트박스 토글
  const radioGlobal = document.getElementById('radioGlobal');
  const radioGame = document.getElementById('radioGame');
  const gameSelectBox = document.getElementById('gameSelectBox');

  if (radioGlobal && radioGame && gameSelectBox) {
    radioGlobal.addEventListener('change', () => {
      if (radioGlobal.checked) gameSelectBox.style.display = 'none';
    });
    radioGame.addEventListener('change', () => {
      if (radioGame.checked) gameSelectBox.style.display = 'inline-block';
    });
  }
</script>

<%- include('../partials/footer') %>
