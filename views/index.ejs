<%- include('partials/header') %>

<main class="main-content">
  <div class="container">

    <!-- 1. 메인 히어로 배너 섹션 -->
    <section class="hero-section">
      <div class="hero-badge">⚡ LEVEL UP YOUR GAMING LIFE</div>
      <h1 class="hero-title">
        모든 게이머가 모이는 곳,<br>
        현대적인 게임 커뮤니티 <span>GameCafe</span>
      </h1>
      <p class="hero-desc">
        리그 오브 레전드부터 발로란트, 오버워치 2, 마인크래프트까지!<br>
        검증된 공략, 실시간 게임 소식, 그리고 함께 승리할 파티원을 지금 찾아보세요.
      </p>
      <div class="hero-buttons">
        <a href="/games/lol" class="btn btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
          게임 라운지 입장하기
        </a>
        <a href="/auth/register" class="btn btn-secondary">
          회원가입하고 소통하기
        </a>
      </div>
    </section>

    <!-- DB 연결 에러 알림 (MySQL 미실행 시 안전 안내) -->
    <% if (typeof dbError !== 'undefined' && dbError) { %>
      <div style="background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 10px; padding: 18px 24px; margin-bottom: 36px; color: #fecdd3;">
        <h4 style="color: #fb7185; margin-bottom: 6px; font-weight: 700;">⚠️ 데이터베이스 연결 안내</h4>
        <p style="font-size: 0.92rem; line-height: 1.6;">
          현재 MySQL 데이터베이스 데몬이 실행되지 않았거나 연결 설정 중입니다.<br>
          터미널에서 <code>sudo service mysql start</code> 실행 후 <code>npm run test:db</code>로 연결을 확인해 주세요.
        </p>
      </div>
    <% } %>

    <!-- 2. 게임별 라운지 메뉴 섹션 (리그 오브 레전드, 발로란트, 오버워치 2, 마인크래프트) -->
    <section class="game-hub-section">
      <div class="section-header">
        <h2 class="section-title">
          <span class="section-title-icon">🎮</span>
          게임별 전용 라운지
        </h2>
        <span class="section-link">원하는 게임을 클릭하여 전용 게시판으로 이동하세요</span>
      </div>

      <div class="game-hub-grid">
        <% if (typeof games !== 'undefined' && games.length > 0) { %>
          <% games.forEach(game => { %>
            <a href="/games/<%= game.slug %>" class="game-card">
              <div class="game-card-top">
                <div class="game-card-icon">
                  <% if (game.slug === 'lol') { %>⚔️
                  <% } else if (game.slug === 'valorant') { %>🎯
                  <% } else if (game.slug === 'overwatch2') { %>🛡️
                  <% } else if (game.slug === 'minecraft') { %>⛏️
                  <% } else { %>🎮<% } %>
                </div>
                <div>
                  <h3 class="game-card-name"><%= game.name %></h3>
                  <span class="badge badge-game">라운지 바로가기</span>
                </div>
              </div>
              <p class="game-card-desc"><%= game.description || '최신 공략과 파티 모집이 진행 중입니다.' %></p>
              <div class="game-card-footer">
                <span>커뮤니티 입장</span>
                <span>&rarr;</span>
              </div>
            </a>
          <% }); %>
        <% } else { %>
          <!-- 기본 정적 카드 fallback -->
          <a href="/games/lol" class="game-card">
            <div class="game-card-top">
              <div class="game-card-icon">⚔️</div>
              <div>
                <h3 class="game-card-name">리그 오브 레전드</h3>
                <span class="badge badge-game">LOL 라운지</span>
              </div>
            </div>
            <p class="game-card-desc">라이엇 게임즈의 대표 5:5 MOBA 게임 커뮤니티</p>
            <div class="game-card-footer"><span>입장하기</span><span>&rarr;</span></div>
          </a>
          <a href="/games/valorant" class="game-card">
            <div class="game-card-top">
              <div class="game-card-icon">🎯</div>
              <div>
                <h3 class="game-card-name">발로란트</h3>
                <span class="badge badge-game">VALORANT 라운지</span>
              </div>
            </div>
            <p class="game-card-desc">전술적 5:5 1인칭 캐릭터 기반 슈팅 게임</p>
            <div class="game-card-footer"><span>입장하기</span><span>&rarr;</span></div>
          </a>
          <a href="/games/overwatch2" class="game-card">
            <div class="game-card-top">
              <div class="game-card-icon">🛡️</div>
              <div>
                <h3 class="game-card-name">오버워치 2</h3>
                <span class="badge badge-game">OW2 라운지</span>
              </div>
            </div>
            <p class="game-card-desc">블리자드의 팀 기반 액션 히어로 슈터</p>
            <div class="game-card-footer"><span>입장하기</span><span>&rarr;</span></div>
          </a>
          <a href="/games/minecraft" class="game-card">
            <div class="game-card-top">
              <div class="game-card-icon">⛏️</div>
              <div>
                <h3 class="game-card-name">마인크래프트</h3>
                <span class="badge badge-game">MINECRAFT 라운지</span>
              </div>
            </div>
            <p class="game-card-desc">무한한 블록 세계를 탐험하고 창조하는 샌드박스 게임</p>
            <div class="game-card-footer"><span>입장하기</span><span>&rarr;</span></div>
          </a>
        <% } %>
      </div>
    </section>

    <!-- 3. 메인 그리드 레이아웃 (좌측 피드 + 우측 사이드바) -->
    <div class="main-grid">
      <!-- 메인 피드 (인기글 & 최신글) -->
      <div class="main-feed">

        <!-- 🔥 실시간 인기 게시글 (좋아요 순 정렬) -->
        <section class="feed-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-title-icon" style="color: var(--accent-rose);">🔥</span>
              실시간 인기 게시글
            </h2>
            <span class="section-link">추천수가 높은 화제의 게시글</span>
          </div>

          <div class="post-cards-grid">
            <% if (typeof popularPosts !== 'undefined' && popularPosts.length > 0) { %>
              <% popularPosts.forEach(post => { %>
                <article class="post-card">
                  <div class="post-card-meta">
                    <% if (post.game_name) { %>
                      <span class="badge badge-game"><%= post.game_name %></span>
                    <% } %>
                    <span class="badge badge-category"><%= post.category_name %></span>
                  </div>
                  <a href="/posts/<%= post.id %>">
                    <h3 class="post-card-title"><%= post.title %></h3>
                  </a>
                  <p class="post-card-snippet">
                    <%= post.content.replace(/<[^>]*>?/gm, '').substring(0, 80) %>...
                  </p>
                  <div class="post-card-footer">
                    <span class="post-author">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                      <%= post.author_nickname %>
                    </span>
                    <div class="post-stats">
                      <span class="stat-item likes" title="추천 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                        <%= post.like_count %>
                      </span>
                      <span class="stat-item comments" title="댓글 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                        <%= post.comment_count %>
                      </span>
                      <span class="stat-item" title="조회 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <%= post.view_count %>
                      </span>
                    </div>
                  </div>
                </article>
              <% }); %>
            <% } else { %>
              <div style="grid-column: 1 / -1; padding: 40px; text-align: center; background: var(--bg-card); border-radius: var(--radius-md); border: 1px dashed var(--border-accent); color: var(--text-dim);">
                <p>아직 등록된 게시글이 없습니다. 첫 번째 글을 작성해 보세요!</p>
              </div>
            <% } %>
          </div>
        </section>

        <!-- ⏱️ 최신 게시글 (작성일 순 정렬) -->
        <section class="feed-section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-title-icon" style="color: var(--accent-cyan-light);">⏱️</span>
              최신 게시글
            </h2>
            <span class="section-link">커뮤니티에 방금 올라온 새로운 글</span>
          </div>

          <div class="post-cards-grid">
            <% if (typeof recentPosts !== 'undefined' && recentPosts.length > 0) { %>
              <% recentPosts.forEach(post => { %>
                <article class="post-card">
                  <div class="post-card-meta">
                    <% if (post.game_name) { %>
                      <span class="badge badge-game"><%= post.game_name %></span>
                    <% } %>
                    <span class="badge badge-category"><%= post.category_name %></span>
                  </div>
                  <a href="/posts/<%= post.id %>">
                    <h3 class="post-card-title"><%= post.title %></h3>
                  </a>
                  <p class="post-card-snippet">
                    <%= post.content.replace(/<[^>]*>?/gm, '').substring(0, 80) %>...
                  </p>
                  <div class="post-card-footer">
                    <span class="post-author">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                      <%= post.author_nickname %>
                    </span>
                    <div class="post-stats">
                      <span class="stat-item likes" title="추천 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                        <%= post.like_count %>
                      </span>
                      <span class="stat-item comments" title="댓글 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                        <%= post.comment_count %>
                      </span>
                      <span class="stat-item" title="조회 수">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <%= post.view_count %>
                      </span>
                    </div>
                  </div>
                </article>
              <% }); %>
            <% } else { %>
              <div style="grid-column: 1 / -1; padding: 40px; text-align: center; background: var(--bg-card); border-radius: var(--radius-md); border: 1px dashed var(--border-accent); color: var(--text-dim);">
                <p>등록된 최신 게시글이 없습니다.</p>
              </div>
            <% } %>
          </div>
        </section>

      </div>

      <!-- 우측 사이드바 -->
      <aside class="sidebar">

        <!-- 📢 공지사항 위젯 (전체 공지 & 게임별 공지) -->
        <div class="sidebar-widget">
          <div class="widget-header">
            <h3 class="widget-title">
              <span>📢</span>
              커뮤니티 공지사항
            </h3>
            <span class="badge badge-global-notice">Official</span>
          </div>

          <div class="notice-list">
            <% if (typeof noticePosts !== 'undefined' && noticePosts.length > 0) { %>
              <% noticePosts.forEach(notice => { %>
                <div class="notice-item">
                  <div class="notice-header">
                    <% if (notice.notice_type === 'global') { %>
                      <span class="badge badge-global-notice">전체공지</span>
                    <% } else { %>
                      <span class="badge badge-game-notice"><%= notice.game_name || '게임공지' %></span>
                    <% } %>
                    <span class="notice-date"><%= notice.created_at ? notice.created_at.substring(0, 10) : '' %></span>
                  </div>
                  <a href="/posts/<%= notice.id %>" class="notice-link">
                    <%= notice.title %>
                  </a>
                </div>
              <% }); %>
            <% } else { %>
              <p style="font-size: 0.85rem; color: var(--text-dim); text-align: center; padding: 12px 0;">등록된 공지사항이 없습니다.</p>
            <% } %>
          </div>
        </div>

        <!-- 🎮 게임 라운지 바로가기 리스트 위젯 -->
        <div class="sidebar-widget">
          <div class="widget-header">
            <h3 class="widget-title">
              <span>⚡</span>
              인기 게임 라운지
            </h3>
          </div>
          <div style="display: flex; flex-direction: column; gap: 8px;">
            <a href="/games/lol" class="dropdown-item" style="background: var(--bg-surface);">
              <span class="dropdown-item-icon">⚔️</span>
              <div>
                <div style="font-weight: 700; color: #fff;">리그 오브 레전드</div>
                <div style="font-size: 0.75rem; color: var(--text-dim);">소환사의 협곡 공략 & 패치</div>
              </div>
            </a>
            <a href="/games/valorant" class="dropdown-item" style="background: var(--bg-surface);">
              <span class="dropdown-item-icon">🎯</span>
              <div>
                <div style="font-weight: 700; color: #fff;">발로란트</div>
                <div style="font-size: 0.75rem; color: var(--text-dim);">경쟁전 파티 구인 & 셋업</div>
              </div>
            </a>
            <a href="/games/overwatch2" class="dropdown-item" style="background: var(--bg-surface);">
              <span class="dropdown-item-icon">🛡️</span>
              <div>
                <div style="font-weight: 700; color: #fff;">오버워치 2</div>
                <div style="font-size: 0.75rem; color: var(--text-dim);">영웅 조합 & 경쟁전 토론</div>
              </div>
            </a>
            <a href="/games/minecraft" class="dropdown-item" style="background: var(--bg-surface);">
              <span class="dropdown-item-icon">⛏️</span>
              <div>
                <div style="font-weight: 700; color: #fff;">마인크래프트</div>
                <div style="font-size: 0.75rem; color: var(--text-dim);">서버 홍보 & 건축 공유</div>
              </div>
            </a>
          </div>
        </div>

        <!-- 💬 파티 구인 배너 위젯 -->
        <div class="community-banner">
          <h4>👥 함께 플레이할 팀원 찾기</h4>
          <p>디스코드 마이크를 켜고 같이 랭크 게임을 뛸 파티원을 구해보세요!</p>
          <a href="/games/lol?category=recruit" class="btn btn-cyan btn-sm" style="width: 100%;">
            파티 모집글 보러가기
          </a>
        </div>

      </aside>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
